    "item":  [
                 {
                     "name":  "Tenant Provisioning",
                     "item":  [
                                  {
                                      "name":  "Provision Tenant",
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027tenant provisioned\u0027, function () { pm.response.to.have.status(201); });",
                                                                                    "const body = pm.response.json();",
                                                                                    "if (body.tenantId) pm.collectionVariables.set(\u0027tenantId\u0027, body.tenantId);",
                                                                                    "if (body.keyId) pm.collectionVariables.set(\u0027keyId\u0027, body.keyId);"
                                                                                ]
                                                                   }
                                                    }
                                                ],
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"name\": \"Acme Tenant\"\n}"
                                                               },
                                                      "url":  {
                                                                  "raw":  "{{baseUrl}}/internal/tenants/provision",
                                                                  "host":  [
                                                                               "{{baseUrl}}"
                                                                           ],
                                                                  "path":  [
                                                                               "internal",
                                                                               "tenants",
                                                                               "provision"
                                                                           ]
                                                              }
                                                  }
                                  }
                              ]
