                 {
                     "name":  "Profiles and Permissions",
                     "item":  [
                                  {
                                      "name":  "List Profiles",
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027profiles returned\u0027, function () { pm.response.to.have.status(200); });",
                                                                                    "const profiles = pm.response.json();",
                                                                                    "const employee = profiles.find(p =\u003e p.name === \u0027EMPLOYEE\u0027) || profiles[0];",
                                                                                    "if (employee \u0026\u0026 employee.id) pm.collectionVariables.set(\u0027profileId\u0027, employee.id);"
                                                                                ]
                                                                   }
                                                    }
                                                ],
                                      "request":  {
                                                      "method":  "GET",
                                                      "header":  [

                                                                 ],
