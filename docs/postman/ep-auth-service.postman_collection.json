                     "name":  "Authentication",
                     "item":  [
                                  {
                                      "name":  "Onboard User",
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027user onboarded\u0027, function () { pm.response.to.have.status(201); });",
                                                                                    "const body = pm.response.json();",
                                                                                    "if (body.userId) pm.collectionVariables.set(\u0027userId\u0027, body.userId);",
                                                                                    "if (body.email) pm.collectionVariables.set(\u0027userEmail\u0027, body.email);",
                                                                                    "if (body.temporaryPassword) pm.collectionVariables.set(\u0027temporaryPassword\u0027, body.temporaryPassword);"
                                                                                ]
