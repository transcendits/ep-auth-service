{
    "info":  {
                 "name":  "EP Auth Service - Token Requests",
                 "description":  "Run Provision Tenant + B2B Client first. Its test script stores the one-time credentials for Generate B2B Token.",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "variable":  [
                     {
                         "key":  "authBaseUrl",
                         "value":  "http://localhost:8080"
                     },
                     {
                         "key":  "tenantId",
                         "value":  "11111111-1111-1111-1111-111111111111"
                     },
                     {
                         "key":  "orgId",
                         "value":  "22222222-2222-2222-2222-222222222222"
                     },
                     {
                         "key":  "authUserId",
                         "value":  "00000000-0000-0000-0000-000000000001"
                     },
                     {
                         "key":  "b2bClientId",
                         "value":  ""
                     },
                     {
                         "key":  "b2bClientSecret",
                         "value":  ""
                     },
                     {
                         "key":  "email",
                         "value":  "john.doe@example.com"
                     },
                     {
                         "key":  "password",
                         "value":  "Password@123"
                     },
                     {
                         "key":  "refreshToken",
                         "value":  ""
                     }
                 ],
    "item":  [
                 {
                     "name": "Provision Tenant + B2B Client",
                     "event": [
                         {
                             "listen": "test",
                             "script": {
                                 "type": "text/javascript",
                                 "exec": [
                                     "const body = pm.response.json();",
                                     "pm.collectionVariables.set('b2bClientId', body.b2bClient.clientId);",
                                     "if (body.b2bClient.clientSecret) {",
                                     "  pm.collectionVariables.set('b2bClientSecret', body.b2bClient.clientSecret);",
                                     "}"
                                 ]
                             }
                         }
                     ],
                     "request": {
                         "auth": { "type": "noauth" },
                         "method": "POST",
                         "header": [{ "key": "Content-Type", "value": "application/json" }],
                         "body": {
                             "mode": "raw",
                             "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"name\": \"EP Tenant\",\n  \"orgId\": \"{{orgId}}\",\n  \"b2bClientName\": \"employee-service\",\n  \"b2bAudience\": \"b2b\",\n  \"b2bPermissions\": [\"member:read\", \"member:write\", \"member:admin\"]\n}",
                             "options": { "raw": { "language": "json" } }
                         },
                         "url": "{{authBaseUrl}}/internal/tenants/provision"
                     },
                     "response": []
                 },
                 {
                     "name":  "Generate B2B Token",
                     "request":  {
                                     "auth":  {
                                                  "type":  "noauth"
                                              },
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n  \"clientId\": \"{{b2bClientId}}\",\n  \"clientSecret\": \"{{b2bClientSecret}}\",\n  \"tenantId\": \"{{tenantId}}\",\n  \"orgId\": \"{{orgId}}\",\n  \"audience\": \"b2b\"\n}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              }
                                              },
                                     "url":  "{{authBaseUrl}}/api/v1/auth/token/generateb2b"
                                 },
                     "response":  [

                                  ]
                 },
                 {
                     "name":  "Generate B2C Token",
                     "request":  {
                                     "auth":  {
                                                  "type":  "noauth"
                                              },
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n  \"userId\": \"{{authUserId}}\",\n  \"audience\": \"b2c\"\n}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              }
                                              },
                                     "url":  "{{authBaseUrl}}/api/v1/auth/token/generateb2c"
                                 },
                     "response":  [

                                  ]
                 },
                 {
                     "name":  "Login",
                     "request":  {
                                     "auth":  {
                                                  "type":  "noauth"
                                              },
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              }
                                              },
                                     "url":  "{{authBaseUrl}}/auth/user/login"
                                 },
                     "response":  [

                                  ]
                 },
                 {
                     "name":  "Refresh Token",
                     "request":  {
                                     "auth":  {
                                                  "type":  "noauth"
                                              },
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              }
                                              },
                                     "url":  "{{authBaseUrl}}/auth/token/refresh"
                                 },
                     "response":  [

                                  ]
                 },
                 {
                     "name":  "JWKS",
                     "request":  {
                                     "auth":  {
                                                  "type":  "noauth"
                                              },
                                     "method":  "GET",
                                     "header":  [

                                                ],
                                     "url":  "{{authBaseUrl}}/auth/.well-known/jwks.json"
                                 },
                     "response":  [

                                  ]
                 }
             ]
}
